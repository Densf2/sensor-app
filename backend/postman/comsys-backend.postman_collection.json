{
  "info": {
    "name": "comsys-backend",
    "description": "NestJS CRUD REST API) датчик температури та датчик вологості.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "tempSensorId", "value": "", "type": "string" },
    { "key": "humiditySensorId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "CheckServerWorking",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
      }
    },
    {
      "name": "Temperature Sensors",
      "item": [
        {
          "name": "Create temperature sensor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('tempSensorId', json.id);",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensorName\": \"Temp\",\n  \"value\": 27,\n  \"unit\": \"C\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sensors",
              "host": ["{{baseUrl}}"],
              "path": ["sensors"]
            }
          }
        },
        {
          "name": "Get all temperature sensors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sensors",
              "host": ["{{baseUrl}}"],
              "path": ["sensors"]
            }
          }
        },
        {
          "name": "Get temperature sensor by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sensors/{{tempSensorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "{{tempSensorId}}"]
            }
          }
        },
        {
          "name": "Update temperature sensor",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sensors/{{tempSensorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "{{tempSensorId}}"]
            }
          }
        },
        {
          "name": "Create temperature sensor - invalid body",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensorName\": \"Bad\",\n  \"value\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sensors",
              "host": ["{{baseUrl}}"],
              "path": ["sensors"]
            }
          }
        },
        {
          "name": "Delete temperature sensor",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sensors/{{tempSensorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "{{tempSensorId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Humidity Sensors",
      "item": [
        {
          "name": "Create humidity sensor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('humiditySensorId', json.id);",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensorName\": \"Humid-1\",\n  \"value\": 55,\n  \"unit\": \"%\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/humidity-sensors",
              "host": ["{{baseUrl}}"],
              "path": ["humidity-sensors"]
            }
          }
        },
        {
          "name": "Get all humidity sensors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/humidity-sensors",
              "host": ["{{baseUrl}}"],
              "path": ["humidity-sensors"]
            }
          }
        },
        {
          "name": "Get humidity sensor by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/humidity-sensors/{{humiditySensorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["humidity-sensors", "{{humiditySensorId}}"]
            }
          }
        },
        {
          "name": "Update humidity sensor",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": 60\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/humidity-sensors/{{humiditySensorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["humidity-sensors", "{{humiditySensorId}}"]
            }
          }
        },
        {
          "name": "Create humidity sensor - invalid body",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensorName\": \"Bad\",\n  \"value\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/humidity-sensors",
              "host": ["{{baseUrl}}"],
              "path": ["humidity-sensors"]
            }
          }
        },
        {
          "name": "Delete humidity sensor",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/humidity-sensors/{{humiditySensorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["humidity-sensors", "{{humiditySensorId}}"]
            }
          }
        }
      ]
    }
  ]
}
